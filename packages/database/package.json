    "studio": "bun --env-file=../../apps/core/.env drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tulocal/environment": "workspace:*",
    "drizzle-orm": "^0.45.2"
