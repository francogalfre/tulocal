{
  "name": "@tulocal/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./schema/authentication": "./src/schema/authentication.ts"
  },
  "scripts": {
    "check:types": "tsc --noEmit",
