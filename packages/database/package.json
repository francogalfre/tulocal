{
  "name": "@tulocal/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./schema/authentication": "./src/schema/authentication.ts",
    "./schema/columns": "./src/schema/columns.ts",
    "./schema/comparables": "./src/schema/comparables.ts",
    "./schema/conversations": "./src/schema/conversations.ts",
    "./schema/creations": "./src/schema/creations.ts",
    "./schema/escalations": "./src/schema/escalations.ts",
    "./schema/images": "./src/schema/images.ts",
    "./schema/messages": "./src/schema/messages.ts",
    "./schema/products": "./src/schema/products.ts",
    "./schema/questions": "./src/schema/questions.ts",
    "./schema/relations": "./src/schema/relations.ts",
    "./schema/scenes": "./src/schema/scenes.ts",
    "./schema/stores": "./src/schema/stores.ts",
    "./schema/subscriptions": "./src/schema/subscriptions.ts",
    "./schema/visits": "./src/schema/visits.ts"
  },
  "scripts": {
    "check:types": "tsc --noEmit",
    "push": "bun --env-file=../../apps/core/.env drizzle-kit push",
    "generate": "bun --env-file=../../apps/core/.env drizzle-kit generate",
    "migrate": "bun --env-file=../../apps/core/.env drizzle-kit migrate",
    "studio": "bun --env-file=../../apps/core/.env drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tulocal/environment": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@tulocal/configuration": "workspace:*",
    "drizzle-kit": "^0.31.10"
  }
}
