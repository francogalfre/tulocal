{
  "name": "@tulocal/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "bun --env-file=../../apps/server/.env drizzle-kit push",
    "db:generate": "bun --env-file=../../apps/server/.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../apps/server/.env drizzle-kit migrate",
    "db:studio": "bun --env-file=../../apps/server/.env drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tulocal/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
