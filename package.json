{
  "name": "tulocal",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "check:types": "turbo run check:types",
    "test": "turbo run test",
    "check:format": "oxfmt --check",
    "database:generate": "bun run --filter @tulocal/database generate",
    "database:migrate": "bun run --filter @tulocal/database migrate",
    "database:push": "bun run --filter @tulocal/database push",
    "database:studio": "bun run --filter @tulocal/database studio"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@oxlint/plugins": "^1.82.0",
    "@tulocal/configuration": "workspace:*",
    "@types/node": "^26.5.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
